---
import Base from "../layouts/Base.astro";
---
<Base title="Private Trade Review" description="A private review of your own trades by an open, published method. Find where they leak money. No tips, no calls.">
<header class="nav">
  <div class="wrap">
    <a class="brand" href="#top"><b>Private Trade Review</b><span>by Tracktions</span></a>
    <nav class="nav-links" aria-label="Sections">
      <a class="hide-sm" href="/sample">Sample review</a>
      <a class="hide-sm" href="#finds">What it finds</a>
      <a class="hide-sm" href="#method">Method</a>
      <a class="hide-sm" href="#privacy">Privacy</a>
      <a class="hide-sm" href="#pricing">Price</a>
      <a class="btn" href="#pricing">Book a review</a>
    </nav>
  </div>
</header>

<main id="top">
  <section class="hero">
    <div class="wrap">
      <div class="hero-copy">
        <div class="eyebrow">For serious traders · any market, any broker</div>
        <h1>Find where your own trades <em>leak money.</em></h1>
        <p class="lede">A private review of your full trade history, measured with a published method. Analysed on a local machine. No tips, no calls.</p>
        <div class="gate"><span>For traders with <b data-price="capital">₹25L+</b> in capital or <b>500+</b> trades, and at least <b>100</b> closed trades per strategy.</span></div>
        <div class="cta-row">
          <a class="btn" href="#pricing">Book a review</a>
          <a class="btn ghost" href="/sample">Read a real review</a>
        </div>
        <div class="price-note">Founding reviews <b data-price="founding">₹9,999</b> · 3 places, open until 11 Dec 2026 · free file check before you pay</div>
      </div>

      <figure class="sheet" id="example" aria-label="Sample review, Case 001, published with the trader's permission">
        <div class="sheet-head"><span><b>Sample review</b> · Case 001</span><span>Index options · 185 trades</span></div>
        <div class="sheet-body">
          <div class="chart">
            <div class="chart-title"><span>Net P&amp;L per day, 38 days</span><span>+₹2,01,141 net</span></div>
            <svg viewBox="0 0 340 126" role="img" aria-label="Daily net P&amp;L over 38 days. Most days are small losses; two days, 15 September and 8 October, made more than the whole net profit.">
              <line class="zero" x1="4" y1="100.1" x2="336" y2="100.1"/>
              <rect class="bar tail" x="5.3" y="100.1" width="6.1" height="3.8"/>
              <rect class="bar win" x="14.0" y="80.0" width="6.1" height="20.0"/>
              <rect class="bar tail" x="22.8" y="100.1" width="6.1" height="6.1"/>
              <rect class="bar win" x="31.5" y="95.5" width="6.1" height="4.6"/>
              <rect class="bar tail" x="40.3" y="100.1" width="6.1" height="1.0"/>
              <rect class="bar win" x="49.0" y="99.8" width="6.1" height="1.0"/>
              <rect class="bar tail" x="57.7" y="100.1" width="6.1" height="6.8"/>
              <rect class="bar tail" x="66.5" y="100.1" width="6.1" height="1.0"/>
              <rect class="bar tail" x="75.2" y="100.1" width="6.1" height="7.8"/>
              <rect class="bar tail" x="83.9" y="100.1" width="6.1" height="2.2"/>
              <rect class="bar tail" x="92.7" y="100.1" width="6.1" height="3.9"/>
              <rect class="bar win" x="101.4" y="97.5" width="6.1" height="2.6"/>
              <rect class="bar tail" x="110.2" y="100.1" width="6.1" height="1.0"/>
              <rect class="bar tail" x="118.9" y="100.1" width="6.1" height="1.0"/>
              <rect class="bar tail" x="127.6" y="100.1" width="6.1" height="1.9"/>
              <rect class="bar win" x="136.4" y="97.0" width="6.1" height="3.1"/>
              <rect class="bar win" x="145.1" y="99.9" width="6.1" height="1.0"/>
              <rect class="bar tail" x="153.8" y="100.1" width="6.1" height="2.9"/>
              <rect class="bar tail" x="162.6" y="100.1" width="6.1" height="3.7"/>
              <rect class="bar tail" x="171.3" y="100.1" width="6.1" height="6.2"/>
              <rect class="bar win" x="180.0" y="99.6" width="6.1" height="1.0"/>
              <rect class="bar tail" x="188.8" y="100.1" width="6.1" height="1.9"/>
              <rect class="bar tail" x="197.5" y="100.1" width="6.1" height="6.6"/>
              <rect class="bar win" x="206.3" y="100.0" width="6.1" height="1.0"/>
              <rect class="bar win" x="215.0" y="12.0" width="6.1" height="88.1"/>
              <rect class="bar tail" x="223.7" y="100.1" width="6.1" height="11.7"/>
              <rect class="bar tail" x="232.5" y="100.1" width="6.1" height="1.0"/>
              <rect class="bar tail" x="241.2" y="100.1" width="6.1" height="1.7"/>
              <rect class="bar win" x="249.9" y="89.7" width="6.1" height="10.3"/>
              <rect class="bar tail" x="258.7" y="100.1" width="6.1" height="2.5"/>
              <rect class="bar win" x="267.4" y="96.3" width="6.1" height="3.8"/>
              <rect class="bar win" x="276.2" y="98.5" width="6.1" height="1.6"/>
              <rect class="bar win" x="284.9" y="99.7" width="6.1" height="1.0"/>
              <rect class="bar tail" x="293.6" y="100.1" width="6.1" height="3.7"/>
              <rect class="bar win" x="302.4" y="95.3" width="6.1" height="4.8"/>
              <rect class="bar tail" x="311.1" y="100.1" width="6.1" height="2.0"/>
              <rect class="bar tail" x="319.8" y="100.1" width="6.1" height="17.9"/>
              <rect class="bar win" x="328.6" y="46.6" width="6.1" height="53.4"/>
              <text class="axis" x="226" y="22">15 Sep</text>
              <text class="axis" x="326" y="42" text-anchor="end">8 Oct</text>
            </svg>
          </div>
          <div class="findings">
            <div class="finding"><span>Made on 2 of 38 days</span><span class="v">+₹2,94,646</span></div>
            <div class="finding"><span>Result of the other 36 days</span><span class="v leak">−₹93,505</span></div>
            <div class="finding"><span>From 2 positions the system logged as "orphaned"</span><span class="v">71.5% of net</span></div>
            <div class="finding"><span>Trades opened 11:00–14:00</span><span class="v leak">89 trades · −₹65,177</span></div>
            <div class="finding"><span>Strategies that lost money</span><span class="v leak">3 of 5</span></div>
          </div>
          <div class="coverage">
            <span>Where 1R comes from</span>
            <div class="coverage-bar" aria-hidden="true">
              <i style="width:100%;background:color-mix(in srgb, var(--accent) 45%, var(--rule))"></i>
            </div>
            <span>Trailing stops only, so 1R = each strategy's average loss · 1 of 5 strategies has an edge that stays positive</span>
          </div>
        </div>
        <figcaption class="sheet-foot">A real review, published with the trader's permission. <a href="/sample">Read the full sample →</a></figcaption>
      </figure>
    </div>
  </section>

  <section class="block" id="finds">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow">What the review finds</div>
        <h2>Your P&amp;L shows the total. We show what's behind it.</h2>
        <p>Every finding comes from your own trades and is shown in your currency and in R, strategy by strategy, so you can see what each habit costs.</p>
      </div>
      <div class="grid-3">
        <div class="cell"><span class="tag">Risk</span><h3>Is your risk per trade consistent?</h3><p>How much you put at risk on each trade, and how far your biggest trades sit from your normal size.</p></div>
        <div class="cell"><span class="tag">Stops</span><h3>Do you honour your stops?</h3><p>How many losses ran past your planned risk, and what that tail cost you in total.</p></div>
        <div class="cell"><span class="tag">Behaviour</span><h3>What happens after a loss?</h3><p>Whether you trade faster or bigger after losing, and how those trades turn out.</p></div>
        <div class="cell"><span class="tag">Timing</span><h3>When do you lose money?</h3><p>Results by time of day, day of week, holding time and expiry or event days.</p></div>
        <div class="cell"><span class="tag">Costs</span><h3>Where do charges hurt most?</h3><p>Your broker shows total charges. We show which strategies, sizes and trade frequencies they hit hardest, and how many gross wins they turn into net losses.</p></div>
        <div class="cell"><span class="tag">Edge</span><h3>Is there a measured edge?</h3><p>Expectancy and SQN after charges, with how confident your sample lets us be.</p></div>
      </div>
    </div>
  </section>

  <section class="block" id="method">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow">Open method</div>
        <h2>Every number has a published source.</h2>
        <p>Nothing here is a black box. Each measure comes from published trading research or standard statistics, so you can check how we got every finding.</p>
      </div>
      <div class="method" role="table" aria-label="Measures and their sources">
        <div class="method-head" role="row"><span role="columnheader">Measure</span><span role="columnheader">What it tells you</span><span role="columnheader">Source</span></div>
        <div class="method-row" role="row">
          <h3 role="cell">R-multiples and expectancy</h3>
          <p role="cell">Each trade's result divided by the risk you planned, so trades of different sizes can be compared. Expectancy is the average R per trade.</p>
          <cite role="cell">Van K. Tharp<span>Trade Your Way to Financial Freedom</span></cite>
        </div>
        <div class="method-row" role="row">
          <h3 role="cell">System Quality Number (SQN)</h3>
          <p role="cell">How large and how steady your edge is, relative to how much your results vary.</p>
          <cite role="cell">Van K. Tharp<span>The Definitive Guide to Position Sizing</span></cite>
        </div>
        <div class="method-row" role="row">
          <h3 role="cell">Monte Carlo resampling</h3>
          <p role="cell">Thousands of reshuffled orderings of your own trades, showing the range of drawdowns and losing streaks your strategy can produce.</p>
          <cite role="cell">Bootstrap resampling<span>Efron (1979), Annals of Statistics</span></cite>
        </div>
        <div class="method-row" role="row">
          <h3 role="cell">Holding losers, cutting winners</h3>
          <p role="cell">Whether you close winning trades sooner than losing ones.</p>
          <cite role="cell">The disposition effect<span>Shefrin &amp; Statman (1985); Odean (1998), Journal of Finance</span></cite>
        </div>
        <div class="method-row" role="row">
          <h3 role="cell">Overtrading</h3>
          <p role="cell">Whether more trades and more turnover leave you with less after costs.</p>
          <cite role="cell">Barber &amp; Odean (2000)<span>Trading Is Hazardous to Your Wealth, Journal of Finance</span></cite>
        </div>
        <div class="method-row" role="row">
          <h3 role="cell">Risk-taking after a loss</h3>
          <p role="cell">Whether you take bigger or faster trades to win back a loss, and what those trades return.</p>
          <cite role="cell">Coval &amp; Shumway (2005)<span>Do Behavioral Biases Affect Prices?, Journal of Finance</span></cite>
        </div>
        <div class="method-row" role="row">
          <h3 role="cell">Confidence in every finding</h3>
          <p role="cell">A finding from 20 trades can be luck. Each result comes with how sure the sample lets us be, which is why we ask for 100+ trades per strategy.</p>
          <cite role="cell">Standard confidence intervals<span>Applied per strategy</span></cite>
        </div>
      </div>
      <div class="open-closed">
        <div>
          <h3>What we publish</h3>
          <ul>
            <li>Every measure we use and the research behind it</li>
            <li>Which trades a finding is based on, so you can check it</li>
            <li>Where each trade's 1R came from: your stop, your rule, or an estimate</li>
            <li>How confident each finding is</li>
          </ul>
        </div>
        <div>
          <h3>What takes the work</h3>
          <ul>
            <li>Rebuilding clean trades from messy broker exports, partial exits and expiries</li>
            <li>Charges that match what you actually paid</li>
            <li>Turning dozens of numbers into the three leaks that matter for you</li>
            <li>A person who walks you through it</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="block" id="how">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow">How it works</div>
        <h2>Send what you have. No template to follow.</h2>
        <p>Any broker, any market, any file: a broker export, a spreadsheet or contract notes. Most broker files have no stops, and that's fine. For each trade we need:</p>
      </div>
      <div class="fields" aria-label="Fields needed for each trade">
        <span>Date and time</span><span>Instrument</span><span>Buy or sell</span><span>Quantity</span><span>Price</span><span class="opt">Stop-loss, if you set one</span><span class="opt">Target, if you set one</span><span class="opt">Charges, if your file has them</span><span class="opt">Strategy name, if you use more than one</span>
      </div>
      <ol class="steps">
        <li><h3>Send your history</h3><p>Your complete trade history, in whatever format you already have.</p></li>
        <li><h3>A 15-minute call</h3><p>How you set stops, size trades and group trades into strategies.</p></li>
        <li><h3>Local analysis</h3><p>Your trades are rebuilt and measured on a local machine, net of charges.</p></li>
        <li><h3>Report and walkthrough</h3><p>A written report and a one-hour call through every finding.</p></li>
      </ol>
    </div>
  </section>

  <section class="block" id="privacy">
    <div class="wrap split">
      <div class="section-head">
        <div class="eyebrow">Private by design</div>
        <h2>Your trades stay yours.</h2>
        <p>Your strategy is your edge. The review is set up so your trade history doesn't end up in someone else's database.</p>
      </div>
      <div class="stack">
        <ul class="list">
          <li><div><b>Analysed on a local machine</b><span>Not uploaded to a web app or a shared cloud database.</span></div></li>
          <li><div><b>Names and account numbers removed first</b><span>Before anything else happens to your file.</span></div></li>
          <li><div><b>Deleted after 30 days</b><span>Or sooner, the day you ask.</span></div></li>
          <li><div><b>No broker access needed</b><span>We never ask for your login, password, API key or OTP. Files only.</span></div></li>
        </ul>
        <p class="fineprint">To read unusual file layouts we use an AI tool on the column headings and a few sample rows, after names and account numbers are removed. Your full history is converted and analysed locally. Files sent by email pass through your email provider; you can send a password-protected file instead.</p>
      </div>
    </div>
  </section>

  <section class="block" id="not">
    <div class="wrap split">
      <div class="section-head">
        <div class="eyebrow">What this is not</div>
        <h2>We describe your record. You decide what to change.</h2>
        <p>Most traders have never seen their own leaks in rupees: which days, which hours, which strategies. Seeing them clearly is the work.</p>
      </div>
      <ul class="list no">
        <li><div><b>No tips or trade calls</b><span>We never tell you what to buy, sell or hold.</span></div></li>
        <li><div><b>No strategies to copy</b><span>We measure the strategy you already trade.</span></div></li>
        <li><div><b>No groups or courses</b><span>One review, one report, one call.</span></div></li>
        <li><div><b>No promised returns</b><span>We show what your past trades cost you, not what you will make.</span></div></li>
      </ul>
    </div>
  </section>

  <section class="block" id="pricing">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow">Price</div>
        <h2>Founding reviews: three places at half price.</h2>
        <p>The first three reviews are half the list price. In return, you give a short written testimonial and permission to publish your findings anonymised, as in the <a href="/sample">sample review</a>. Every review starts with a free file check before you pay.</p>
      </div>
      <div class="region" role="group" aria-label="Show price for">
        <button type="button" id="region-in" data-region="in" aria-pressed="true">India</button>
        <button type="button" id="region-intl" data-region="intl" aria-pressed="false">Outside India</button>
      </div>
      <!-- Replace the href with your payment link (Razorpay for India, a card payment link for outside India) -->
      <div class="price-card featured">
        <div class="eyebrow">Founding review</div>
        <div class="price-line"><span class="amount" data-price="founding">₹9,999</span><s data-price="review">₹19,999</s></div>
        <span class="pill">3 places · open until 11 Dec 2026</span>
        <ul class="list">
          <li><div><b>Up to 3 strategies, up to 2,500 trades</b><span>Each strategy measured separately, then compared. Longer histories get a quote first.</span></div></li>
          <li><div><b>Every leak with its cost</b><span>Which trades, when they happened and what they cost, in rupees and, where your stops allow, in R.</span></div></li>
          <li><div><b>One-hour walkthrough</b><span>On video call, at a time that suits you.</span></div></li>
          <li><div><b>In return</b><span>A short testimonial and permission to publish your findings anonymised.</span></div></li>
        </ul>
        <a class="btn" href="#pricing" data-payment-link>Claim a founding place</a>
      </div>
      <div class="assurances">
        <div><b>Free file check</b><span>Trade count, strategies and the right option, confirmed before you pay.</span></div>
        <div><b>No charge if the data can't support a review</b><span>Too few trades or too little detail, and we say so first.</span></div>
        <div><b>A clean record is a result</b><span>If we find few leaks, the report shows the numbers that say your process holds up.</span></div>
      </div>
      <p class="price-note">After the founding places: <b data-price="review">₹19,999</b> per review · reports within 10 working days</p>
    </div>
  </section>

  <section class="block" id="faq">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow">Questions</div>
        <h2>Before you book.</h2>
      </div>
      <div class="faq">
        <details><summary>Can I see a real review first?</summary><p>Yes. <a href="/sample">Case 001</a> is a real review, published with the trader's permission: a profitable options record whose profit came from two days. It also shows what we leave out when the data can't support a number.</p></details>
        <details><summary>Why at least 100 trades per strategy?</summary><p>Below about 100 trades, a winning or losing streak can look like an edge or a flaw when it's only chance. Each strategy needs its own 100, because mixing strategies hides what each one does. If you have fewer, we'll tell you before you pay.</p></details>
        <details><summary>Who is this for?</summary><p>Traders who run it like a business: <span data-price="capital">₹25L+</span> in trading capital or 500+ trades, with at least 100 closed trades in each strategy you want reviewed.</p></details>
        <details><summary>What if you don't find many leaks?</summary><p>Then that's your result. The report shows the numbers behind it: your stops held, your size stayed steady, your edge survived charges. Knowing your process holds up is worth as much as finding a leak, and it tells you when it's sensible to trade larger.</p></details>
        <details><summary>My history is very long. Which option do I need?</summary><p>Send it for the free file check. We count closed trades per strategy and tell you which option fits. Histories over 2,500 trades or with more than three strategies get a fixed quote before any work starts.</p></details>
        <details><summary>Which brokers and markets do you support?</summary><p>Any. Send the file your broker gives you, a spreadsheet you keep, or contract notes. We convert it ourselves, so you don't have to follow a template.</p></details>
        <details><summary>What if some trades have no stop-loss recorded?</summary><p>That's normal: most broker files have none. Your findings are measured in rupees first, so they don't need stops. For R, we use the stop you recorded wherever it exists, then the rule you describe on the call, then an estimate from your average loss, marked as such. The report shows how many trades used each method, and leaves out SQN when too few trades have a real stop.</p></details>
        <details><summary>Will you tell me what to trade or how many lots to take?</summary><p>No. We aren't a SEBI-registered investment adviser or research analyst, and the review doesn't recommend any security, trade or position size. It shows what your own record says. The decisions stay yours.</p></details>
        <details><summary>What happens to my files afterwards?</summary><p>They're deleted 30 days after your walkthrough, or sooner if you ask. The report is yours to keep.</p></details>
      </div>
    </div>
  </section>

  <section class="closing" id="contact">
    <div class="wrap">
      <div class="eyebrow">Three founding places</div>
      <h2>See what your last 400 trades are telling you.</h2>
      <div class="cta-row">
        <a class="btn" href="#pricing">Book a review</a>
      </div>
      <div class="contact">Questions first? <code id="email">hello@tracktions.com</code><button class="copy" type="button" id="copy-email">Copy</button></div>
    </div>
  </section>
</main>

<footer>
  <div class="wrap">
    <p>Private Trade Review is a service of Tracktions. It describes a client's past trades and is not investment advice or research. We are not registered with SEBI as an investment adviser or research analyst. Past results do not indicate future results.</p>
    <p>© 2026 Tracktions</p>
  </div>
</footer>
</Base>

<style is:global>
/* Layout: a calm canvas of thin-ruled sheets; one ink-blue accent; the example report sheet is the hero object. */
:root {
  --canvas: #f6f6f4;
  --sheet: #ffffff;
  --ink: #141414;
  --muted: #6b6b68;
  --rule: #e4e4e0;
  --accent: #2b45d9;
  --accent-soft: #e8ecff;
  --leak: #c2410c;
  --leak-soft: #fdebe2;
  --gain: #3f7d52;
  --glow-a: rgba(43, 69, 217, 0.10);
  --glow-b: rgba(194, 65, 12, 0.07);
  --font-display: "Instrument Serif", "Iowan Old Style", Georgia, serif;
  --font-body: "Geist", ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
  --font-mono: "Geist Mono", ui-monospace, "SF Mono", Menlo, Consolas, monospace;
  --radius: 14px;
  --step--1: 0.8125rem;
  --step-0: 1rem;
  --step-1: 1.1875rem;
  --step-3: clamp(2rem, 4.2vw, 2.75rem);
  --step-4: clamp(2.75rem, 7vw, 5rem);
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --canvas: #111211; --sheet: #191a19; --ink: #ededea; --muted: #9a9a95; --rule: #2a2b29;
    --accent: #8197ff; --accent-soft: #1d2340; --leak: #f08a5d; --leak-soft: #3a2117; --gain: #7cc191;
    --glow-a: rgba(129, 151, 255, 0.10); --glow-b: rgba(240, 138, 93, 0.06);
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --canvas: #111211; --sheet: #191a19; --ink: #ededea; --muted: #9a9a95; --rule: #2a2b29;
  --accent: #8197ff; --accent-soft: #1d2340; --leak: #f08a5d; --leak-soft: #3a2117; --gain: #7cc191;
  --glow-a: rgba(129, 151, 255, 0.10); --glow-b: rgba(240, 138, 93, 0.06);
  color-scheme: dark;
}

* { box-sizing: border-box; }
body {
  background: var(--canvas);
  color: var(--ink);
  font: 400 var(--step-0)/1.6 var(--font-body);
  -webkit-font-smoothing: antialiased;
}
a { color: inherit; }
a:focus-visible, button:focus-visible, summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 6px; }

.wrap {
  max-width: 1120px;
  margin: 0 auto;
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
}

/* Nav */
.nav { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 5; backdrop-filter: blur(12px); background: color-mix(in srgb, var(--canvas) 82%, transparent); border-bottom: 1px solid var(--rule); }
body::before { content: ""; position: fixed; inset: 0 0 auto; height: env(safe-area-inset-top, 0px); z-index: 10; background: var(--canvas); }
.nav .wrap { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 14px; }
.brand { display: flex; align-items: baseline; gap: 10px; text-decoration: none; }
.brand b { font-weight: 600; letter-spacing: -0.01em; }
.brand span { font: 400 var(--step--1) var(--font-mono); color: var(--muted); }
.nav-links { display: flex; gap: 22px; align-items: center; font-size: var(--step--1); }
.nav-links a { text-decoration: none; color: var(--muted); }
.nav-links a:hover { color: var(--ink); }
@media (max-width: 760px) { .nav-links .hide-sm { display: none; } }

.btn {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 11px 18px; border-radius: 999px;
  font: 500 var(--step--1)/1 var(--font-body); text-decoration: none;
  border: 1px solid var(--ink); background: var(--ink); color: var(--canvas);
  transition: transform .15s ease;
}
.nav-links a.btn { color: var(--canvas); }
.btn:hover { transform: translateY(-1px); }
.btn.ghost { background: transparent; color: var(--ink); border-color: var(--rule); }
.btn.ghost:hover { border-color: var(--ink); }

/* Hero */
.hero { position: relative; overflow: hidden; }
.hero::before {
  content: ""; position: absolute; inset: -20% -10% auto -10%; height: 140%;
  background:
    radial-gradient(40% 50% at 78% 30%, var(--glow-a), transparent 70%),
    radial-gradient(30% 40% at 18% 70%, var(--glow-b), transparent 70%);
  pointer-events: none;
}
.hero .wrap { position: relative; display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(32px, 5vw, 72px); align-items: center; padding-block: clamp(56px, 9vw, 112px) clamp(48px, 7vw, 96px); }
@media (max-width: 900px) { .hero .wrap { grid-template-columns: 1fr; } }
.hero-copy { min-width: 0; display: grid; gap: 22px; }
.eyebrow { font: 500 var(--step--1)/1.3 var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
h1 { margin: 0; font: 400 var(--step-4)/0.98 var(--font-display); letter-spacing: -0.02em; text-wrap: balance; }
h1 em { font-style: italic; color: var(--accent); }
.lede { margin: 0; font-size: var(--step-1); color: var(--muted); max-width: 36ch; text-wrap: pretty; }
.cta-row { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
.price-note { font: 400 var(--step--1) var(--font-mono); color: var(--muted); }
.price-note b { color: var(--ink); font-weight: 500; }
.gate { display: inline-flex; gap: 10px; align-items: center; padding: 8px 12px; border: 1px solid var(--rule); border-radius: 10px; background: var(--sheet); font: 400 var(--step--1) var(--font-mono); width: fit-content; max-width: 100%; }
.gate b { font-weight: 500; color: var(--accent); }

/* Example report sheet */
.sheet {
  min-width: 0; margin: 0;
  background: var(--sheet); border: 1px solid var(--rule); border-radius: var(--radius);
  box-shadow: 0 1px 0 var(--rule), 0 24px 60px -32px rgba(0,0,0,.25);
  overflow: hidden;
}
.sheet-head { display: flex; justify-content: space-between; gap: 12px; padding: 14px 18px; border-bottom: 1px solid var(--rule); font: 400 var(--step--1) var(--font-mono); color: var(--muted); }
.sheet-head b { color: var(--ink); font-weight: 500; }
.sheet-body { padding: 18px; display: grid; gap: 18px; }
.chart-title { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; font-size: var(--step--1); }
.chart-title span:last-child { font-family: var(--font-mono); color: var(--muted); }
.chart svg { display: block; width: 100%; height: auto; }
.chart .axis { fill: var(--muted); font: 400 10px var(--font-mono); }
.chart .bar { fill: var(--rule); }
.chart .bar.win { fill: color-mix(in srgb, var(--gain) 55%, var(--rule)); }
.chart .bar.tail { fill: var(--leak); }
.chart .zero { stroke: var(--ink); stroke-width: 1; stroke-dasharray: 2 3; }
.findings { display: grid; border-top: 1px solid var(--rule); }
.finding { display: grid; grid-template-columns: 1fr auto; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--rule); font-size: var(--step--1); }
.finding:last-child { border-bottom: 0; }
.finding .v { font-family: var(--font-mono); font-variant-numeric: tabular-nums; white-space: nowrap; }
.finding .v.leak { color: var(--leak); }
.coverage { display: grid; gap: 6px; font: 400 var(--step--1) var(--font-mono); color: var(--muted); }
.coverage-bar { display: flex; height: 6px; border-radius: 99px; overflow: hidden; background: var(--rule); }
.coverage-bar i { display: block; }
.sheet-foot { padding: 10px 18px; border-top: 1px solid var(--rule); font: 400 11px var(--font-mono); color: var(--muted); }

/* Sections */
section.block .wrap { padding-block: clamp(56px, 8vw, 104px); display: grid; gap: clamp(28px, 4vw, 44px); }
section.block + section.block .wrap { border-top: 1px solid var(--rule); }
.section-head { display: grid; gap: 12px; max-width: 660px; }
h2 { margin: 0; font: 400 var(--step-3)/1.05 var(--font-display); letter-spacing: -0.015em; text-wrap: balance; }
.section-head p { margin: 0; color: var(--muted); max-width: 60ch; }

.grid-3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: var(--rule); border: 1px solid var(--rule); border-radius: var(--radius); overflow: hidden; }
@media (max-width: 900px) { .grid-3 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 560px) { .grid-3 { grid-template-columns: 1fr; } }
.cell { background: var(--sheet); padding: 22px; display: grid; gap: 8px; align-content: start; min-width: 0; }
.cell h3 { margin: 0; font: 500 var(--step-0)/1.3 var(--font-body); }
.cell p { margin: 0; color: var(--muted); font-size: var(--step--1); }
.cell .tag { font: 400 11px var(--font-mono); color: var(--accent); letter-spacing: 0.04em; text-transform: uppercase; }

/* Method table */
.method { display: grid; border-top: 1px solid var(--ink); }
.method-row { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.6fr) minmax(0, 1.3fr); gap: 20px; padding: 18px 0; border-bottom: 1px solid var(--rule); align-items: start; }
@media (max-width: 760px) { .method-row { grid-template-columns: 1fr; gap: 6px; } }
.method-row h3 { margin: 0; font: 500 var(--step-0)/1.35 var(--font-body); }
.method-row p { margin: 0; color: var(--muted); font-size: var(--step--1); }
.method-row cite { font: 400 var(--step--1)/1.5 var(--font-mono); font-style: normal; color: var(--ink); }
.method-row cite span { display: block; color: var(--muted); }
.method-head { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.6fr) minmax(0, 1.3fr); gap: 20px; padding: 10px 0; font: 400 11px var(--font-mono); text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
@media (max-width: 760px) { .method-head { display: none; } }
.open-closed { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--rule); border: 1px solid var(--rule); border-radius: var(--radius); overflow: hidden; }
@media (max-width: 700px) { .open-closed { grid-template-columns: 1fr; } }
.open-closed > div { background: var(--sheet); padding: 22px; display: grid; gap: 10px; align-content: start; min-width: 0; }
.open-closed h3 { margin: 0; font: 500 var(--step-0) var(--font-body); }
.open-closed ul { margin: 0; padding-left: 18px; color: var(--muted); font-size: var(--step--1); display: grid; gap: 6px; }

.steps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; counter-reset: step; list-style: none; margin: 0; padding: 0; }
@media (max-width: 900px) { .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 560px) { .steps { grid-template-columns: 1fr; } }
.steps li { counter-increment: step; display: grid; gap: 8px; align-content: start; padding-top: 16px; border-top: 1px solid var(--ink); min-width: 0; }
.steps li::before { content: "Step " counter(step); font: 400 var(--step--1) var(--font-mono); color: var(--muted); }
.steps h3 { margin: 0; font: 500 var(--step-0)/1.3 var(--font-body); }
.steps p { margin: 0; color: var(--muted); font-size: var(--step--1); }

.fields { display: flex; flex-wrap: wrap; gap: 8px; }
.fields span { font: 400 var(--step--1) var(--font-mono); padding: 6px 10px; border: 1px solid var(--rule); border-radius: 8px; background: var(--sheet); }
.fields span.opt { color: var(--muted); border-style: dashed; }

.split { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 5vw, 64px); align-items: start; }
@media (max-width: 820px) { .split { grid-template-columns: 1fr; } }
.split > * { min-width: 0; }
.stack { display: grid; gap: 18px; }
.list { list-style: none; margin: 0; padding: 0; display: grid; border-top: 1px solid var(--rule); }
.list li { display: grid; grid-template-columns: 22px 1fr; gap: 10px; padding: 14px 0; border-bottom: 1px solid var(--rule); }
.list li::before { content: "✓"; color: var(--gain); font-family: var(--font-mono); }
.list.no li::before { content: "✕"; color: var(--leak); }
.list b { font-weight: 500; }
.list span { color: var(--muted); font-size: var(--step--1); display: block; }
.fineprint { font-size: var(--step--1); color: var(--muted); max-width: 60ch; margin: 0; }

/* Pricing */
.region { display: inline-flex; padding: 3px; border: 1px solid var(--rule); border-radius: 999px; background: var(--sheet); width: fit-content; }
.region button { font: 500 var(--step--1)/1 var(--font-body); padding: 8px 14px; border-radius: 999px; border: 0; background: transparent; color: var(--muted); cursor: pointer; }
.region button[aria-pressed="true"] { background: var(--ink); color: var(--canvas); }
.price-card { background: var(--sheet); border: 1px solid var(--rule); border-radius: var(--radius); padding: clamp(22px, 4vw, 36px); display: grid; gap: 18px; max-width: 580px; }
.price-line { display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; }
.price-line .amount { font: 400 clamp(2.5rem, 6vw, 3.5rem)/1 var(--font-display); }
.price-line s { font-family: var(--font-mono); color: var(--muted); }
.pill { font: 500 11px var(--font-mono); text-transform: uppercase; letter-spacing: 0.05em; padding: 5px 10px; border-radius: 99px; background: var(--accent-soft); color: var(--accent); }
.tiers { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; align-items: start; max-width: 900px; }
@media (max-width: 760px) { .tiers { grid-template-columns: 1fr; max-width: 580px; } }
.tiers .price-card { max-width: none; gap: 14px; min-width: 0; }
.tiers .price-card.featured { border-color: var(--accent); box-shadow: 0 24px 60px -36px color-mix(in srgb, var(--accent) 60%, transparent); }
.tiers .amount { font-size: clamp(2.25rem, 4vw, 2.75rem); }
.tiers .pill { width: fit-content; }
.tiers .btn { justify-content: center; }
.from { font: 400 var(--step--1) var(--font-mono); color: var(--muted); }
.tier-lede { margin: 0; color: var(--muted); font-size: var(--step--1); }
.assurances { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
@media (max-width: 760px) { .assurances { grid-template-columns: 1fr; } }
.assurances > div { display: grid; gap: 4px; padding-top: 14px; border-top: 1px solid var(--ink); min-width: 0; }
.assurances b { font-weight: 500; }
.assurances span { color: var(--muted); font-size: var(--step--1); }

/* FAQ */
.faq { display: grid; border-top: 1px solid var(--rule); max-width: 760px; }
.faq details { border-bottom: 1px solid var(--rule); }
.faq summary { cursor: pointer; list-style: none; padding: 18px 0; display: flex; justify-content: space-between; gap: 16px; font-weight: 500; }
.faq summary::-webkit-details-marker { display: none; }
.faq summary::after { content: "+"; font-family: var(--font-mono); color: var(--muted); }
.faq details[open] summary::after { content: "−"; }
.faq details p { margin: 0 0 18px; color: var(--muted); max-width: 64ch; }

/* Closing */
.closing .wrap { padding-block: clamp(64px, 10vw, 120px); display: grid; gap: 22px; justify-items: start; border-top: 1px solid var(--rule); }
.closing h2 { font-size: var(--step-4); line-height: 1; max-width: 16ch; }
.contact { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; font: 400 var(--step--1) var(--font-mono); color: var(--muted); }
.contact code { color: var(--ink); user-select: all; }
.copy { font: 500 11px var(--font-mono); padding: 6px 10px; border-radius: 99px; border: 1px solid var(--rule); background: transparent; color: var(--ink); cursor: pointer; }

footer .wrap { padding-block: 28px; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; border-top: 1px solid var(--rule); font: 400 11px/1.6 var(--font-mono); color: var(--muted); }
footer p { margin: 0; max-width: 70ch; }

@media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
</style>

<script>
  const PRICES = {
    in:   { founding: "₹9,999", review: "₹19,999", capital: "₹25L+" },
    intl: { founding: "$149",   review: "$299",    capital: "$50k+" }
  };
  const INDIA_TIME_ZONES = ["Asia/Kolkata", "Asia/Calcutta"];

  function showRegion(region) {
    document.querySelectorAll("[data-price]").forEach((element) => {
      element.textContent = PRICES[region][element.dataset.price];
    });
    document.querySelectorAll(".region button").forEach((button) => {
      button.setAttribute("aria-pressed", String(button.dataset.region === region));
    });
  }

  function regionFromTimeZone() {
    const zone = Intl.DateTimeFormat().resolvedOptions().timeZone;
    return INDIA_TIME_ZONES.includes(zone) ? "in" : "intl";
  }

  document.querySelectorAll(".region button").forEach((button) => {
    button.addEventListener("click", () => showRegion(button.dataset.region));
  });
  showRegion(regionFromTimeZone());

  document.getElementById("copy-email").addEventListener("click", (event) => {
    const button = event.currentTarget;
    const email = document.getElementById("email");
    navigator.clipboard.writeText(email.textContent)
      .then(() => { button.textContent = "Copied"; })
      .catch(() => {
        const range = document.createRange();
        range.selectNodeContents(email);
        const selection = window.getSelection();
        selection.removeAllRanges();
        selection.addRange(range);
        button.textContent = "Selected";
      });
  });
</script>
